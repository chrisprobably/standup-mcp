{
  "name": "thestandup-mcp",
  "version": "1.0.0",
  "description": "MCP server for Standup kanban board",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "standup-mcp": "dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "all": "tsc --noEmit && vitest run",
    "prepublishOnly": "npm run all && npm run build"
  },
  "keywords": ["mcp", "standup", "kanban"],
  "repository": {
    "type": "git",
    "url": "https://github.com/chrisprobably/standup-mcp"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "semantic-release": "^25.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
